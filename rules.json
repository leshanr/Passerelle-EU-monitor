{
  "_comment": "The editorial intelligence of EU Monitor. Two independent axes. BEATS decide what a development is about and therefore where it sits in the digest. SIGNALS decide why it might matter and are printed next to every flag as the reason it surfaced. Tune this file, never collect.py — that separation is the whole point.",
  "_tuning_note": "Starting values, calibrated against a first source audit on 27 August 2026 and nothing else. Expect two or three cycles of adjustment before the signal is right. Every adjustment goes in docs/TUNING-LOG.md, because the tuning process is itself publishable material.",

  "window_days": 14,
  "stale_after_days": 21,
  "tier1_bonus": 2,
  "beat_cap": 30,

  "flag_tiers": {
    "significant": {
      "min_score": 25,
      "min_signals": 2,
      "_why": "Two independent reasons to care, and enough topical weight to not be a routine administrative notice."
    },
    "investigate": {
      "min_score": 55,
      "min_signals": 3,
      "requires_any": ["youth", "unusual", "decided", "consequential", "uk"],
      "_why": "The top tier must clear the score bar AND carry at least one signal that makes it worth a young reader's ten minutes. A development can be geopolitically enormous and still be the fourth Ukraine statement that fortnight — that is what requires_any filters out."
    }
  },

  "caps": {
    "investigate": 10,
    "significant": 25,
    "detected": 40,
    "_why": "A review list you do not finish is worth nothing. Ten items at the top is one evening's work."
  },

