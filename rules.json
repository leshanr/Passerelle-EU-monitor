  "signals": [
    {
      "id": "new",
      "name": "Genuinely new",
      "weight": 2,
      "min_score": 2,
      "_why": "Distinguishes a first move from the eighth procedural step of something announced in March.",
      "keywords": {
        "proposes": 3, "proposal for": 3, "launches": 3, "unveils": 4,
